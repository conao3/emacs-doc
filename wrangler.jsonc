{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emacs-doc",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "emacs-doc.conao3.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
