msgid ""
"<span>8.3.1 The Body of <code class=\"code\">copy-region-as-kill</code><a "
"class=\"copiable-link\" href=\"#The-Body-of-"
"copy_002dregion_002das_002dkill\"> &para;</a></span>"
msgstr ""
