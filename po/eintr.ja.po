msgid "M-x edebug-defun <kbd class=\"key\">RET</kbd>\n"
msgstr ""

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><p>
#: build/html/eintr/edebug.html build/html/mono/eintr.html
msgid ""
"This will cause Emacs to load Edebug automatically if it is not already "
"loaded, and properly instrument the function."
msgstr ""
"これにより、Emacsがまだロードされていない場合は自動的にEdebugをロードし、関数"
"を適切にインストルメントします。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><p>
#: build/html/eintr/edebug.html build/html/mono/eintr.html
msgid ""
