#: build/html/mono/eintr.html
msgid ""
"The function has an <code class=\"code\">if</code> expression after the "
"documentation string.  It tests whether the value of <code "
"class=\"code\">number</code> is equal to 1; if so, Emacs evaluates the then-"
"part of the <code class=\"code\">if</code> expression, which returns the "
"number 1 as the value of the function.  (A triangle with one row has one "
"pebble in it.)"
msgstr ""
