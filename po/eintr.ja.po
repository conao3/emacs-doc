"     &rArr; 1\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><hr><div><div><div><pre>
#: build/html/eintr/length.html build/html/mono/eintr.html
#, no-wrap
msgid ""
"(length '(daisy buttercup))\n"
"     &rArr; 2\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><hr><div><div><div><pre>
