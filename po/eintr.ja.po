#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><p>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
msgid ""
"You can specify colors when you use Emacs with the MIT X Windowing system."
msgstr "MIT X WindowingシステムでEmacsを使用する際は、色を指定できます。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><p>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
msgid "I dislike the default colors and specify my own."
msgstr "デフォルトの色が気に入らないので、自分で指定します。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><p>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
msgid ""
"Here are the expressions in my <samp class=\"file\">.emacs</samp> file that "
"set values:"
msgstr ""
"私の<samp class=\"file\">.emacs</samp>ファイル内で値を設定している式は以下の"
"通りです："

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
#, no-wrap
msgid ""
";; Set cursor color\n"
"(set-cursor-color &quot;white&quot;)\n"
"\n"
";; Set mouse color\n"
"(set-mouse-color &quot;white&quot;)\n"
"\n"
";; Set foreground and background\n"
"(set-foreground-color &quot;white&quot;)\n"
"(set-background-color &quot;darkblue&quot;)\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
#, no-wrap
msgid ""
";;; Set highlighting colors for isearch and drag\n"
"(set-face-foreground 'highlight &quot;white&quot;)\n"
"(set-face-background 'highlight &quot;blue&quot;)\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
#, no-wrap
msgid ""
"(set-face-foreground 'region &quot;cyan&quot;)\n"
"(set-face-background 'region &quot;blue&quot;)\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
#, no-wrap
msgid ""
"(set-face-foreground 'secondary-selection &quot;skyblue&quot;)\n"
"(set-face-background 'secondary-selection &quot;darkblue&quot;)\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/X11-Colors.html build/html/mono/eintr.html
#, no-wrap
msgid ""
