"<a class=\"index-entry-id\" id=\"index-recursive_002dcount_002dwords\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-recursive_002dcount_002dwords\"></a>"

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/recursive_002dcount_002dwords.html
#: build/html/mono/eintr.html
#, no-wrap
