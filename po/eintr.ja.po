#, no-wrap
msgid "(if (&gt; size 10000)\n"
msgstr ""

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><hr><div><hr><div><p>
#: build/html/eintr/Large-buffer-case.html build/html/mono/eintr.html
msgid ""
"When the buffer is large, the then-part of the <code class=\"code\">if</"
"code> expression is evaluated.  It reads like this (after formatting for "
"easy reading):"
msgstr ""
