msgid ""
"<span>9 How Lists are Implemented<a class=\"copiable-link\" href=\"#How-"
"Lists-are-Implemented\"> &para;</a></span>"
msgstr ""
"<span>9 リストの実装方法<a class=\"copiable-link\" href=\"#How-Lists-are-"
