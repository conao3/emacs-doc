#: build/html/mono/eintr.html
#, no-wrap
msgid ""
"(defun count-words-in-defun ()\n"
"  &quot;Return the number of words and symbols in a defun.&quot;\n"
"  (beginning-of-defun)\n"
"  (let ((count 0)\n"
"        (end (save-excursion (end-of-defun) (point))))\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
