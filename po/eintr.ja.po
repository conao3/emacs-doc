msgid "<a id=\"FOOT21\" href=\"#DOCF21\">(21)</a>"
msgstr "<a id=\"FOOT21\" href=\"#DOCF21\">(21)</a>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/eintr/Simple-Extension.html build/html/mono/eintr.html
msgid ""
"When I start instances of Emacs that do not load my <samp "
"class=\"file\">.emacs</samp> file or any site file, I also turn off blinking:"
msgstr ""
"<samp class=\"file\">.emacs</samp>ファイルやサイトファイルを読み込まないEmacs"
"インスタンスを起動する際は、点滅もオフにしています："

