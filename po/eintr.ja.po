"    (while\n"
"        (and (&lt; (point) end)\n"
"             (re-search-forward\n"
"              &quot;\\\\(\\\\w\\\\|\\\\s_\\\\)+[^ \\t\\n]*[ \\t\\n]*&quot;\n"
"              end t))\n"
"      (setq count (1+ count)))\n"
"    count))\n"
msgstr ""

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><p>
#: build/html/eintr/count_002dwords_002din_002ddefun.html
#: build/html/mono/eintr.html
msgid ""
"How to test this? The function is not interactive, but it is easy to put a "
"wrapper around the function to make it interactive; we can use almost the "
"same code as for the recursive version of <code class=\"code\">count-words-"
"example</code>:"
msgstr ""
"これをどうテストすればよいでしょうか？この関数はインタラクティブではありませ"
"んが、ラッパーを被せてインタラクティブにするのは簡単です。<code "
"class=\"code\">count-words-example</code>の再帰版とほぼ同じコードを使用できま"
"す："

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/count_002dwords_002din_002ddefun.html
#: build/html/mono/eintr.html
#, no-wrap
msgid ""
";;; <span class=\"r\">Interactive version.</span>\n"
"(defun count-words-defun ()\n"
"  &quot;Number of words and symbols in a function definition.&quot;\n"
"  (interactive)\n"
"  (message\n"
"   &quot;Counting words and symbols in function definition ... &quot;)\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/count_002dwords_002din_002ddefun.html
#: build/html/mono/eintr.html
#, no-wrap
msgid ""
"  (let ((count (count-words-in-defun)))\n"
"    (cond\n"
"     ((zerop count)\n"
"      (message\n"
"       &quot;The definition does NOT have any words or symbols.&quot;))\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
