#. type: Content of: <html><body><div><hr><p>
#: build/html/eintr/Wrong-Type-of-Argument.html build/html/mono/eintr.html
msgid ""
"<code class=\"code\">(quote hello)</code> is an expansion of the "
"abbreviation <code class=\"code\">'hello</code>."
msgstr ""
"<code class=\"code\">(quote hello)</code>は、略記<code "
"class=\"code\">'hello</code>を展開したものです。"

