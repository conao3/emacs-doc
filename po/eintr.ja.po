#: build/html/eintr/debug.html build/html/mono/eintr.html
msgid ""
"This will create and enter a <samp class=\"file\">*Backtrace*</samp> buffer "
"that says:"
msgstr ""
"これにより、次のような内容の <samp class=\"file\">*Backtrace*</samp> バッファ"
"が作成され、書き込まれます："

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/debug.html build/html/mono/eintr.html
#, no-wrap
msgid ""
"---------- Buffer: *Backtrace* ----------\n"
"Debugger entered--Lisp error: (void-function 1=)\n"
"  (1= number)\n"
"  (setq number (1= number))\n"
"  (while (&gt; number 0) (setq total (+ total number))\n"
"        (setq number (1= number)))\n"
"  (let ((total 0)) (while (&gt; number 0) (setq total ...)\n"
"    (setq number ...)) total)\n"
"  triangle-bugged(4)\n"
"  eval((triangle-bugged 4) nil)\n"
msgstr ""

#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><div><div><pre>
#: build/html/eintr/debug.html build/html/eintr/debug_002don_002dentry.html
#: build/html/mono/eintr.html
#, no-wrap
msgid ""
"  elisp--eval-last-sexp(nil)\n"
"  #f(compiled-function () #&lt;bytecode ...&gt;)()\n"
"  handler-bind-1(#f(compiled-function () #&lt;bytecode ...&gt;) (error) eval-expression--debug)\n"
"  eval-last-sexp(nil)\n"
"  funcall-interactively(eval-last-sexp nil)\n"
"  call-interactively(eval-last-sexp nil nil)\n"
"  command-execute(eval-last-sexp)\n"
"---------- Buffer: *Backtrace* ----------\n"
