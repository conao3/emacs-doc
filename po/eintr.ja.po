#. type: Content of: <html><body><div><br><br><br><br><br><hr><div><hr><div><hr><div>
#: build/html/eintr/Lisp-macro.html build/html/mono/eintr.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-Macro_002c-lisp\"></a> <a "
"class=\"index-entry-id\" id=\"index-Lisp-macro\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-Macro_002c-lisp\"></a> <a "
