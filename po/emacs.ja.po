# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Compilation.html
msgid ""
"Run a compiler asynchronously under Emacs, with error messages going to the "
"<samp class=\"file\">*compilation*</samp> buffer."
msgstr ""
