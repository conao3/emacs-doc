# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/emacs/Misc-Dired-Features.html
msgid ""
"The command (<code class=\"code\">dired-create-empty-file</code>) reads a "
"file name, and creates that file.  It signals an error if the file already "
"exists."
msgstr ""
