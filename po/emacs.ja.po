"class=\"index-entry-id\" id=\"index-calendar_002dmark_002dholidays\"></a> <a "
"class=\"index-entry-id\" id=\"index-u-_0028Calendar-mode_0029\"></a> <a "
"class=\"index-entry-id\" id=\"index-calendar_002dunmark\"></a> <a "
"class=\"index-entry-id\" id=\"index-"
"calendar_002dmark_002dholidays_002dflag\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-x-_0028Calendar-mode_0029\"></a> <a "
"class=\"index-entry-id\" id=\"index-calendar_002dmark_002dholidays\"></a> <a "
"class=\"index-entry-id\" id=\"index-u-_0028Calendar-mode_0029\"></a> <a "
