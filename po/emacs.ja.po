#: build/html/emacs/Dired-Visiting.html
msgid ""
"Visit the file whose name you clicked on (<code class=\"code\">dired-mouse-"
"find-file-other-window</code>).  This uses another window to display the "
"file, like the <kbd class=\"kbd\">o</kbd> command."
msgstr ""
