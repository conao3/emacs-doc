"echo LC_ALL=$LC_ALL LC_COLLATE=$LC_COLLATE LC_CTYPE=$LC_CTYPE \\\n"
"  LC_MESSAGES=$LC_MESSAGES LC_TIME=$LC_TIME LANG=$LANG\n"
