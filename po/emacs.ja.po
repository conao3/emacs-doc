# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Position-Info.html
msgid "Display the line number of point."
msgstr "ポイントの行番号を表示する。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/emacs/Position-Info.html
msgid "<kbd class=\"kbd\">M-x line-number-mode</kbd>"
msgstr "<kbd class=\"kbd\">M-x line-number-mode</kbd>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/emacs/Position-Info.html
