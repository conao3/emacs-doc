#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Registers.html
msgid ""
"This value is like <code class=\"code\">t</code>, but in addition you can "
"press the same key as the name of register one more time to exit the "
"minibuffer, instead of pressing <kbd class=\"key\">RET</kbd>."
msgstr ""
