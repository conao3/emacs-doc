"a> <a class=\"index-entry-id\" id=\"index-diary_002dentry_002dmarker\"></a> "
"<a class=\"index-entry-id\" id=\"index-calendar_002dtoday_002dmarker\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-calendar_002dholiday_002dmarker\"></"
