"mode_0029\"></a> <a class=\"index-entry-id\" id=\"index-"
"fortran_002dwindow_002dcreate\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-C_002du-C_002dc-C_002dw-_0028Fortran-"
