msgid "Isearch"
msgstr "Isearch"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Glossary.html
msgid ""
"See <a class=\"xref\" href=\"#Glossary_002d_002d_002dIncremental-"
