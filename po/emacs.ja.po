msgstr "<kbd class=\"kbd\">C-c C-q</kbd>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Citing-Mail.html
msgid ""
"Fill each paragraph cited from another message (<code class=\"code\">message-"
"fill-yanked-message</code>)."
msgstr ""
"別のメッセージから引用された各段落（<code class=\"code\">message-fill-yanked-"
"message</code>）を記入してください。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Citing-Mail.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-C_002dc-C_002dy-_0028Message-"
