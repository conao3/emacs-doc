# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Tab-Bars.html
msgid ""
"Add a new tab (<code class=\"code\">tab-new</code>).  You can control the "
"choice of the buffer displayed in a new tab by customizing the variable "
"<code class=\"code\">tab-bar-new-tab-choice</code>.  You can control the "
"names given by default to new tabs by customizing the variable <code "
"class=\"code\">tab-bar-tab-name-function</code>."
msgstr ""
