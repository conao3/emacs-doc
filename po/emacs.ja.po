# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Sunrise_002fSunset.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-S-_0028Calendar-mode_0029\"></a> <a "
"class=\"index-entry-id\" id=\"index-calendar_002dsunrise_002dsunset\"></a> "
