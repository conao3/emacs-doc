# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/emacs/Compilation-Mode.html
msgid ""
"Sometimes <code class=\"code\">compilation-error-regexp-alist</code> "
"doesn&rsquo;t correctly determine the filename that is the source of the "
"error.  Use user option <code class=\"code\">compilation-transform-file-"
"match-alist</code> to make any necessary adjustments, such as adding or "
"changing a directory component, or even considering certain compiler "
"messages not error messages at all."
msgstr ""
