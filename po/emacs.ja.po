"</span>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/emacs/Lisp-Eval.html
msgid "<kbd class=\"kbd\">M-x eval-defun</kbd>"
msgstr "<kbd class=\"kbd\">M-x eval-defun</kbd>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Lisp-Eval.html
msgid ""
"Evaluate the defun containing or after point, and print the value in the "
"echo area (<code class=\"code\">eval-defun</code>)."
msgstr ""
"point 以降に含まれる defun を評価し、その値を echo 領域 (<code "
"class=\"code\">eval-defun</code>) に出力します。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/emacs/Lisp-Eval.html
msgid "<kbd class=\"kbd\">M-x eval-region</kbd>"
msgstr "<kbd class=\"kbd\">M-x eval-region</kbd>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Lisp-Eval.html
msgid "Evaluate all the Emacs Lisp expressions in the region."
msgstr "リージョン内のすべてのEmacs Lisp式を評価する。"

# Machine-translated by PLaMo Translate.
