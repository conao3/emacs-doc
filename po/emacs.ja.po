# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Sentences.html
msgid ""
"Move back to the beginning of the sentence (<code class=\"code\">backward-"
"sentence</code>)."
msgstr "文頭に戻る (<code class=\"code\">backward-sentence</code>)。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Sentences.html
msgid ""
