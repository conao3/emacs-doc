msgid "<var class=\"var\">pixels</var>"
msgstr "<var class=\"var\">pixels</var>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Fonts.html
msgid "The font height, in pixels."
msgstr "フォントの高さ（ピクセル単位）。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/emacs/Fonts.html
