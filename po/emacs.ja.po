# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Code-Alignment.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-code-alignment\"></a> <a "
"class=\"index-entry-id\" id=\"index-aligning-code\"></a>"
