# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Fill-Prefix.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-C_002dx-_002e\"></a> <a class=\"index-"
"entry-id\" id=\"index-set_002dfill_002dprefix\"></a>"
msgstr ""
