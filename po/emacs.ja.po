#. type: Content of: <html><body><div><hr><h3>
#: build/html/emacs/ls-in-Lisp.html
msgid ""
"<span>I.4 Emulation of <code class=\"code\">ls</code> on MS-Windows<a "
"class=\"copiable-link\" href=\"#Emulation-of-ls-on-MS_002dWindows\"> &para;</"
"a></span>"
msgstr ""
