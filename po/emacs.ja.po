# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/emacs/Other-GDB-Buffers.html
msgid ""
"Other buffers provided by <kbd class=\"kbd\">M-x gdb</kbd> whose display you "
"can optionally request include:"
msgstr ""
"<kbd class=\"kbd\">M-x gdb</kbd> が提供するその他のバッファのうち、表示を任意"
