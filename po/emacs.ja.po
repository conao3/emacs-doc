#: build/html/emacs/Image_002dDired.html
msgid ""
"Files that are marked in Dired will also be marked in Image-Dired if <code "
"class=\"code\">image-dired-thumb-visible-marks</code> is non-<code "
"class=\"code\">nil</code> (which is the default)."
msgstr ""
