# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/VC-Directory-Commands.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-vc_002ddir_002dmark\"></a> <a "
"class=\"index-entry-id\" id=\"index-"
"vc_002ddir_002dmark_002dall_002dfiles\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-vc_002ddir_002dmark\"></a> <a "
