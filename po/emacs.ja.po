#: build/html/emacs/Lucid-Resources.html
msgid ""
"Lucid widgets can display multilingual text in your locale.  To enable this, "
"specify a <code class=\"code\">fontSet</code> resource instead of a <code "
"class=\"code\">font</code> resource.  See <a class=\"xref\" "
"href=\"Fontsets.html\">Fontsets</a>.  If both <code class=\"code\">font</"
"code> and <code class=\"code\">fontSet</code> resources are specified, the "
"<code class=\"code\">fontSet</code> resource is used."
msgstr ""
