# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Editing-VC-Commands.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-vc_002dedit_002dnext_002dcommand\"></"
"a> <a class=\"index-entry-id\" id=\"index-C_002dx-v-_0021\"></a>"
msgstr ""
