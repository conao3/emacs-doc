#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/emacs/Registers.html
msgid ""
"<kbd class=\"kbd\">M-x view-register <kbd class=\"key\">RET</kbd> <var "
"class=\"var\">r</var></kbd>"
msgstr ""
"<kbd class=\"kbd\">M-x view-register <kbd class=\"key\">RET</kbd> <var "
"class=\"var\">r</var></kbd>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Registers.html
msgid ""
"Display a description of what register <var class=\"var\">r</var> contains."
msgstr "レジスタ <var class=\"var\">r</var> の内容に関する説明を表示します。"

