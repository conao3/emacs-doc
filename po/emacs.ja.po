# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/emacs/VC_002dAware-Project-Backend.html
msgid ""
"It also uses a time-based cache.  If the mode line shows stale project "
"information, you can type <kbd class=\"kbd\">M-x project-remember-projects-"
"under RET</kbd> to refresh the stale cached info."
msgstr ""
