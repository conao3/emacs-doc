#. type: Content of: <html><body><div><hr><h2>
#: build/html/emacs/Mac-OS-_002f-GNUstep.html
msgid ""
"<span>Appendix F Emacs and macOS / GNUstep<a class=\"copiable-link\" "
"href=\"#Emacs-and-macOS-_002f-GNUstep\"> &para;</a></span>"
msgstr ""
