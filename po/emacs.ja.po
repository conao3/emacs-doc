#: build/html/emacs/General-Calendar.html
msgid ""
"In Calendar mode, you can use <kbd class=\"key\">SPC</kbd> (<code "
"class=\"code\">scroll-other-window</code>)  and <kbd class=\"key\">DEL</kbd> "
"(<code class=\"code\">scroll-other-window-down</code>) to scroll the other "
"window (if there is one) up or down, respectively.  This is handy when you "
"display a list of holidays or diary entries in another window."
msgstr ""
