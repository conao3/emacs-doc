msgstr "<kbd class=\"kbd\">C-M-h</kbd>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Marking-Objects.html
msgid ""
"Move point to the beginning of the current defun, and set mark at the end "
"(<code class=\"code\">mark-defun</code>)."
msgstr ""
"ポイントを現在の defun の先頭に移動し、末尾にマークを設定する (<code "
"class=\"code\">mark-defun</code>)。"

# Machine-translated by PLaMo Translate.
