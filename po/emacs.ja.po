#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Point.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-point\"></a> <a class=\"index-entry-"
"id\" id=\"index-cursor\"></a>"
msgstr ""
