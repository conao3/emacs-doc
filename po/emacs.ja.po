"<a id=\"index-tooltip_002dframe_002dparameters\"></a><span><code "
"class=\"code\">tooltip-frame-parameters</code><a class=\"copiable-link\" "
"href=\"#index-tooltip_002dframe_002dparameters\"> &para;</a></span>"
