#. type: Content of: <html><body><div><hr><h3>
#: build/html/emacs/Keyboard-Macro-Query.html
msgid ""
"<span>19.4 Executing Macros with Variations<a class=\"copiable-link\" "
"href=\"#Executing-Macros-with-Variations\"> &para;</a></span>"
msgstr ""
"<span>19.4 バリエーション付きマクロの実行<a class=\"copiable-link\" "
