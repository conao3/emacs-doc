msgid "&lsquo;<samp class=\"samp\">forwarded</samp>&rsquo;"
msgstr "&lsquo;<samp class=\"samp\">forwarded</samp>&rsquo;"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Rmail-Attributes.html
msgid ""
"Means you have forwarded the message.  Assigned by the <kbd class=\"kbd\">f</"
"kbd> command (<code class=\"code\">rmail-forward</code>).  See <a "
"class=\"xref\" href=\"Rmail-Reply.html\">Sending Replies</a>."
msgstr ""
"メッセージを転送したことを意味します。<kbd class=\"kbd\">f</kbd>コマンド"
"（<code class=\"code\">rmail-forward</code>）によって割り当てられます。<a "
"class=\"xref\" href=\"Rmail-Reply.html\">返信の送信</a>を参照してください。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/emacs/Rmail-Attributes.html
msgid "&lsquo;<samp class=\"samp\">edited</samp>&rsquo;"
msgstr "&lsquo;<samp class=\"samp\">edited</samp>&rsquo;"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Rmail-Attributes.html
msgid ""
