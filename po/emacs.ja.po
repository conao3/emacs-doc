#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Rmail-Labels.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-label-_0028Rmail_0029\"></a> <a "
"class=\"index-entry-id\" id=\"index-attribute-_0028Rmail_0029\"></a>"
msgstr ""
