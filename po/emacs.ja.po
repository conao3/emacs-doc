# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/emacs/Recentering.html
msgid ""
"The <kbd class=\"kbd\">C-l</kbd> (<code class=\"code\">recenter-top-bottom</"
"code>) command <em class=\"dfn\">recenters</em> the selected window, "
"scrolling it so that the current screen line is exactly in the center of the "
"window, or as close to the center as possible."
msgstr ""
"<kbd class=\"kbd\">C-l</kbd> (<code class=\"code\">recenter-top-bottom</"
