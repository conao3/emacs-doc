# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Position-Registers.html
msgid ""
"Jump to the position and buffer saved in register <var class=\"var\">r</var> "
"(<code class=\"code\">jump-to-register</code>)."
msgstr ""
"レジスタ <var class=\"var\">r</var> (<code class=\"code\">jump-to-register</"
"code>) に保存されている位置とバッファにジャンプする。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Position-Registers.html
