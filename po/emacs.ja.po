# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Scroll-Bars.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-Scroll-Bar-mode\"></a> <a "
"class=\"index-entry-id\" id=\"index-mode_002c-Scroll-Bar\"></a> <a "
"class=\"index-entry-id\" id=\"index-Vertical-Scroll-Bar\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-Scroll-Bar-mode\"></a> <a "
