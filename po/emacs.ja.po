#, no-wrap
msgid ""
";; <span class=\"r\">Make the <kbd class=\"key\">ENTER</kbd> key from the numeric keypad act as <kbd class=\"kbd\">C-j</kbd>.</span>\n"
"(keymap-set function-key-map &quot;&lt;kp-enter&gt;&quot; &quot;C-j&quot;)\n"
