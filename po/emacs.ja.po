#. type: Content of: <html><body><div><hr>
#: build/html/emacs/Isearch-Yank.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-M_002ds-M_002d_002e\"></a> <a "
"class=\"index-entry-id\" id=\"index-"
"isearch_002dforward_002dthing_002dat_002dpoint\"></a>"
msgstr ""
