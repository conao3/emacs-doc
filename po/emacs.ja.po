# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/emacs/Blank-Lines.html
msgid ""
"Insert a blank line after the cursor (<code class=\"code\">open-line</code>)."
msgstr "カーソルの後に空行を挿入する (<code class=\"code\">open-line</code>)。"

# Machine-translated by PLaMo Translate.
