"id=\"index-ispell_002dchange_002ddictionary\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-ispell_002ddictionary\"></a> <a "
"class=\"index-entry-id\" id=\"index-ispell_002dlocal_002ddictionary\"></a> "
"<a class=\"index-entry-id\" id=\"index-"
