msgstr ""
"<a class=\"index-entry-id\" id=\"index-shell-commands_002c-Dired\"></a> <a "
"class=\"index-entry-id\" id=\"index-dired_002ddo_002dshell_002dcommand\"></"
"a> <a class=\"index-entry-id\" id=\"index-_0021-_0028Dired_0029\"></a> <a "
"class=\"index-entry-id\" id=\"index-X-_0028Dired_0029\"></a> <a "
