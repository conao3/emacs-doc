# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/emacs/Code-Alignment.html
msgid ""
"On the other hand, <kbd class=\"kbd\">M-x align-entire</kbd> aligns all of "
"the lines as a single section, so the &lsquo;<samp class=\"samp\">=</"
"samp>&rsquo; appears at the same column in all lines:"
msgstr ""
