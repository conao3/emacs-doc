# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><ul><li>
#: build/html/emacs/Manifesto.html
msgid ""
"<a href=\"#Some-Easily-Rebutted-Objections-to-GNU_0027s-Goals\" "
