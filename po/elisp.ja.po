"                   ; 13  =  <span class=\"r\">...001101</span>\n"
"                   ;  4  =  <span class=\"r\">...000100</span>\n"
"     &rArr; 4          ;  4  =  <span class=\"r\">...000100</span>\n"
msgstr ""

