"(overlay-start foo)\n"
"     &rArr; nil\n"
"(overlay-end foo)\n"
"     &rArr; nil\n"
"(overlay-buffer foo)\n"
"     &rArr; nil\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Managing-Overlays.html
#, no-wrap
msgid ""
";; <span class=\"r\">Undelete the overlay.</span>\n"
"(move-overlay foo 1 20)\n"
"     &rArr; #&lt;overlay from 1 to 20 in display.texi&gt;\n"
";; <span class=\"r\">Verify the results.</span>\n"
"(overlay-start foo)\n"
"     &rArr; 1\n"
"(overlay-end foo)\n"
"     &rArr; 20\n"
"(overlay-buffer foo)\n"
"     &rArr; #&lt;buffer display.texi&gt;\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Managing-Overlays.html
#, no-wrap
msgid ""
";; <span class=\"r\">Moving and deleting the overlay does not change its properties.</span>\n"
"(overlay-get foo 'happy)\n"
"     &rArr; t\n"
