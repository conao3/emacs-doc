"name\">marker-insertion-type</strong> <var class=\"def-var-"
"arguments\">marker</var><a class=\"copiable-link\" href=\"#index-"
"marker_002dinsertion_002dtype\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">marker-insertion-type</strong> <var class=\"def-var-"
"arguments\">marker</var><a class=\"copiable-link\" href=\"#index-"
"marker_002dinsertion_002dtype\"> &para;</a></span>"

# Machine-translated by PLaMo Translate.
