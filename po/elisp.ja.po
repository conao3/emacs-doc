"name\">indirect-function</strong> <var class=\"def-var-arguments\">function</"
"var><a class=\"copiable-link\" href=\"#index-indirect_002dfunction\"> &para;"
"</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">indirect-function</strong> <var class=\"def-var-arguments\">function</"
