# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Misc-Events.html
msgid ""
"This event is sent when a system input method tells Emacs to display some "
"text to indicate to the user what will be inserted.  The contents of <var "
"class=\"var\">arg</var> are dependent on the window system being used."
msgstr ""
