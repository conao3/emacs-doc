# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Parsing-Actions.html
msgid ""
"Match <abbr class=\"acronym\">PEX</abbr> <var class=\"var\">e</var> and push "
