msgstr "<a class=\"index-entry-id\" id=\"index-font-object\"></a>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/Low_002dLevel-Font.html
msgid ""
"A font object is a Lisp object that represents a font that Emacs has <em "
"class=\"dfn\">opened</em>.  Font objects cannot be modified in Lisp, but "
"they can be inspected."
msgstr ""
"フォントオブジェクトとは、Emacsが<em class=\"dfn\">開いた</em>フォントを表す"
"Lispオブジェクトです。フォントオブジェクトはLisp上で変更することはできません"
"が、検査することは可能です。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Low_002dLevel-Font.html
msgid ""
"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">font-at</strong> <var class=\"def-var-arguments\">position "
"&amp;optional window string</var><a class=\"copiable-link\" href=\"#index-"
"font_002dat\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">font-at</strong> <var class=\"def-var-arguments\">position "
