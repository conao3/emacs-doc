"name\">make-text-button</strong> <var class=\"def-var-arguments\">beg end "
"&amp;rest properties</var><a class=\"copiable-link\" href=\"#index-"
"make_002dtext_002dbutton\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
