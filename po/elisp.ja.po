msgstr "&lsquo;<samp class=\"samp\">%b</samp>&rsquo;"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Formatting-Strings.html
msgid ""
"<a id=\"index-integer-to-binary\"></a><span>&lsquo;<samp class=\"samp\">%B</"
"samp>&rsquo;<a class=\"copiable-link\" href=\"#index-integer-to-binary\"> "
"&para;</a></span>"
