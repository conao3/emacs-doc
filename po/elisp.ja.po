msgstr "&lsquo;<samp class=\"samp\">[:print:]</samp>&rsquo;"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Char-Classes.html
msgid ""
"This matches any printing character&mdash;either spaces or graphic "
