# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Rings.html
msgid ""
"This returns the object in <var class=\"var\">ring</var> found at index <var "
"class=\"var\">index</var>.  <var class=\"var\">index</var> may be negative "
"or greater than the ring length.  If <var class=\"var\">ring</var> is empty, "
"<code class=\"code\">ring-ref</code> signals an error."
msgstr ""
