"href=\"#index-help_002decho-text-on-fringes\"> &para;</a></span>"
msgstr ""
"<a id=\"index-help_002decho-text-on-fringes\"></a><span><code "
"class=\"code\">left-fringe-help</code><a class=\"copiable-link\" "
"href=\"#index-help_002decho-text-on-fringes\"> &para;</a></span>"

# Machine-translated by PLaMo Translate.
