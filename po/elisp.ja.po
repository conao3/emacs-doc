msgstr "&lsquo;<samp class=\"samp\">i</samp>&rsquo;"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Interactive-Codes.html
msgid ""
