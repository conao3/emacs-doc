#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Margins.html
msgid ""
"<span class=\"category-def\">Command: </span><span><strong class=\"def-"
"name\">set-left-margin</strong> <var class=\"def-var-arguments\">from to "
"margin</var><a class=\"copiable-link\" href=\"#index-"
"set_002dleft_002dmargin\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">コマンド: </span><span><strong class=\"def-"
"name\">set-left-margin</strong> <var class=\"def-var-arguments\">from to "
"margin</var><a class=\"copiable-link\" href=\"#index-"
"set_002dleft_002dmargin\"> &para;</a></span>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Margins.html
msgid ""
"This sets the <code class=\"code\">left-margin</code> property on the text "
"from <var class=\"var\">from</var> to <var class=\"var\">to</var> to the "
"value <var class=\"var\">margin</var>.  If Auto Fill mode is enabled, this "
"command also refills the region to fit the new margin."
msgstr ""
"これにより、<var class=\"var\">from</var>から<var class=\"var\">to</var>まで"
"のテキストの<code class=\"code\">left-margin</code>プロパティに<var "
"class=\"var\">margin</var>という値が設定されます。オートフィルモードが有効な"
"場合、このコマンドは新しい余白に合わせて領域を再充填します。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Margins.html
msgid ""
"<span class=\"category-def\">Command: </span><span><strong class=\"def-"
"name\">set-right-margin</strong> <var class=\"def-var-arguments\">from to "
"margin</var><a class=\"copiable-link\" href=\"#index-"
"set_002dright_002dmargin\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">コマンド: </span><span><strong class=\"def-"
