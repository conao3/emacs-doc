"     &rArr; &quot;hello&quot;\n"
msgstr ""

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Output-Variables.html
msgid ""
"<span class=\"category-def\">Variable: </span><span><strong class=\"def-"
"name\">print-gensym</strong><a class=\"copiable-link\" href=\"#index-"
"print_002dgensym\"> &para;</a></span>"
msgstr ""
