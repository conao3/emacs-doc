"arguments\">string max-pixels &amp;optional buffer ellipsis ellipsis-pixels</"
"var><a class=\"copiable-link\" href=\"#index-"
"truncate_002dstring_002dpixelwise\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">truncate-string-pixelwise</strong> <var class=\"def-var-"
