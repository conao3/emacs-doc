#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Association-Lists.html
msgid ""
"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">rassq</strong> <var class=\"def-var-arguments\">value alist</var><a "
"class=\"copiable-link\" href=\"#index-rassq\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
