"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">uuid-v4</strong> <var class=\"def-var-arguments\">&amp;key rng</"
"var><a class=\"copiable-link\" href=\"#index-uuid_002dv4\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">uuid-v4</strong> <var class=\"def-var-arguments\">&amp;key rng</"
