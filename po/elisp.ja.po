msgid ""
"<a class=\"index-entry-id\" id=\"index-compiled-function\"></a> <a "
"class=\"index-entry-id\" id=\"index-byte_002dcode-function\"></a> <a "
"class=\"index-entry-id\" id=\"index-byte_002dcode-object\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-compiled-function\"></a> <a "
