"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">gnutls-symmetric-encrypt</strong> <var class=\"def-var-"
"arguments\">cipher key iv input &amp;optional aead_auth</var><a "
"class=\"copiable-link\" href=\"#index-gnutls_002dsymmetric_002dencrypt\"> "
"&para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">gnutls-symmetric-encrypt</strong> <var class=\"def-var-"
"arguments\">cipher key iv input &amp;optional aead_auth</var><a "
"class=\"copiable-link\" href=\"#index-gnutls_002dsymmetric_002dencrypt\"> "
"&para;</a></span>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
