#: build/html/elisp/Window-Start-and-End.html
msgid ""
"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">window-end</strong> <var class=\"def-var-arguments\">&amp;optional "
"window update</var><a class=\"copiable-link\" href=\"#index-"
"window_002dend\"> &para;</a></span>"
msgstr ""
