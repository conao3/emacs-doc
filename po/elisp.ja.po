# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/Tree_002dsitter-Major-Modes.html
msgid ""
"Besides <code class=\"code\">beginning-of-defun</code> and <code "
"class=\"code\">end-of-defun</code>, Emacs provides some additional functions "
"for working with defuns: <code class=\"code\">treesit-defun-at-point</code> "
"returns the defun node at point, and <code class=\"code\">treesit-defun-"
"name</code> returns the name of a defun node."
msgstr ""
"<code class=\"code\">beginning-of-defun</code> や <code class=\"code\">end-"
