msgid "This function returns the current buffer&rsquo;s case table."
msgstr "この関数は、現在のバッファの大文字小文字テーブルを返します。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Case-Tables.html
msgid ""
"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
