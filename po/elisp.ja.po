# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Minibuffer-Misc.html
msgid ""
"This variable holds the list of regular expressions for activating the "
"features of <code class=\"code\">minibuffer-regexp-mode</code> in the "
"minibuffer.  The mode&rsquo;s features will be activated only if the "
"minibuffer prompt matches one of the regular expressions in the list."
msgstr ""
