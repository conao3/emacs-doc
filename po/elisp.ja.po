# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Deleting-Windows.html
msgid ""
"This function deletes all windows showing <var class=\"var\">buffer-or-name</"
