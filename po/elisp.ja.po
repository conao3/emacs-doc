"<code class=\"code\">(rx <var class=\"var\">regexp</var> <var "
"class=\"var\">sym0</var> <var class=\"var\">sym1</var>&hellip;)</code>"

# Machine-translated by PLaMo Translate.
#.  /@w 
#.  /@w 
#. type: Content of: <html><body><div><hr><dl><dd><dl><dd><p>
#: build/html/elisp/cond_002a-Macro.html
msgid ""
"Uses a regexp specified in s-expression form, and binds the symbols <var "
