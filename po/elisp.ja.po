#. type: Content of: <html><body><div><hr><ul><li>
#: build/html/elisp/Abstract-Display.html
msgid "The text&rsquo;s start position in the buffer."
msgstr "バッファ内におけるテキストの開始位置。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><ul><li>
#: build/html/elisp/Abstract-Display.html
msgid "The header and footer strings."
msgstr "ヘッダーとフッターの文字列。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><ul><li>
