"name\">read-variable</strong> <var class=\"def-var-arguments\">prompt "
"&amp;optional default</var><a class=\"copiable-link\" href=\"#index-"
"read_002dvariable\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
