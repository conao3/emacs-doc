#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Accessing-Documentation.html
#, no-wrap
msgid ""
"    ;; <span class=\"r\">Display the data.</span>\n"
"    (help-setup-xref (list 'describe-symbols pattern)\n"
"                 (called-interactively-p 'interactive))\n"
"    (with-help-window (help-buffer)\n"
"      (mapcar describe-func (sort sym-list)))))\n"
msgstr ""

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/Accessing-Documentation.html
msgid ""
"The <code class=\"code\">describe-symbols</code> function works like <code "
"class=\"code\">apropos</code>, but provides more information."
msgstr ""
