#: build/html/elisp/Keymap-Type.html
msgid ""
"<span>2.5.13 Keymap Type<a class=\"copiable-link\" href=\"#Keymap-Type-1\"> "
"&para;</a></span>"
msgstr ""
"<span>2.5.13 キーマップタイプ<a class=\"copiable-link\" href=\"#Keymap-"
