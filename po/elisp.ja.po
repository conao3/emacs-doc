# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Insertion.html
msgid ""
"This is like <code class=\"code\">insert-buffer-substring</code> except that "
"it does not copy any text properties."
msgstr ""
