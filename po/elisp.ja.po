# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/Creating-Buffer_002dLocal.html
msgid ""
"A buffer-local variable is <em class=\"dfn\">permanent</em> if the variable "
"name (a symbol) has a <code class=\"code\">permanent-local</code> property "
"that is non-<code class=\"code\">nil</code>.  Such variables are unaffected "
"by <code class=\"code\">kill-all-local-variables</code>, and their local "
"bindings are therefore not cleared by changing major modes.  Permanent "
"locals are appropriate for data pertaining to where the file came from or "
"how to save it, rather than with how to edit the contents."
msgstr ""
