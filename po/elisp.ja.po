"     &rArr; #&lt;overlay from 5 to 20 in display.texi&gt;\n"
"(overlay-start foo)\n"
"     &rArr; 5\n"
"(overlay-end foo)\n"
"     &rArr; 20\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Managing-Overlays.html
#, no-wrap
msgid ""
";; <span class=\"r\">Delete the overlay.</span>\n"
"(delete-overlay foo)\n"
"     &rArr; nil\n"
";; <span class=\"r\">Verify it is deleted.</span>\n"
"foo\n"
"     &rArr; #&lt;overlay in no buffer&gt;\n"
