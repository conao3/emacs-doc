#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Recursive-Editing.html
msgid ""
"<span class=\"category-def\">Command: </span><span><strong class=\"def-"
"name\">exit-recursive-edit</strong><a class=\"copiable-link\" href=\"#index-"
"exit_002drecursive_002dedit\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">コマンド: </span><span><strong class=\"def-"
