"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">current-time-string</strong> <var class=\"def-var-"
"arguments\">&amp;optional time zone</var><a class=\"copiable-link\" "
"href=\"#index-current_002dtime_002dstring\"> &para;</a></span>"
