# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Module-Misc.html
msgid ""
"This function returns <code class=\"code\">true</code> if the user wants to "
"quit.  In that case, we recommend that your module function aborts any on-"
"going processing and returns as soon as possible.  In most cases, use <code "
"class=\"code\">process_input</code> instead."
msgstr ""
