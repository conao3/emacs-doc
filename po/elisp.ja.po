# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/elisp/Byte-Packing.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-byte-packing-and-unpacking\"></a>"
