"count map start end backward region-noncontiguous-p</var><a class=\"copiable-"
"link\" href=\"#index-perform_002dreplace\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
