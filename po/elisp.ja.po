# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Making-Buttons.html
msgid ""
"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">buttonize</strong> <var class=\"def-var-arguments\">string callback "
"&amp;optional data</var><a class=\"copiable-link\" href=\"#index-"
"buttonize\"> &para;</a></span>"
