# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/String-Type.html
msgid ""
"A <em class=\"dfn\">string</em> is an array of characters.  Strings are used "
"for many purposes in Emacs, as can be expected in a text editor; for "
"example, as the names of Lisp symbols, as messages for the user, and to "
"represent text extracted from buffers.  Strings in Lisp are constants: "
"evaluation of a string returns the same string."
msgstr ""
