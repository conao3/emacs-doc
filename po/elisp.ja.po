"name\">expand-file-name</strong> <var class=\"def-var-arguments\">filename "
"&amp;optional directory</var><a class=\"copiable-link\" href=\"#index-"
"expand_002dfile_002dname\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">expand-file-name</strong> <var class=\"def-var-arguments\">filename "
"&amp;optional directory</var><a class=\"copiable-link\" href=\"#index-"
"expand_002dfile_002dname\"> &para;</a></span>"

