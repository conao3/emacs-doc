msgstr "<code class=\"code\"><var class=\"var\">regexp</var></code>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Search_002dbased-Fontification.html
msgid ""
"Highlight all matches for <var class=\"var\">regexp</var> using <code "
"class=\"code\">font-lock-keyword-face</code>.  For example,"
msgstr ""
"<code class=\"code\">font-lock-keyword-face</code>を使用して<var "
"class=\"var\">regexp</var>のすべてのマッチをハイライトします。例えば、"

