"     &rArr; 256\n"
"(string-to-number &quot;25 is a perfect square.&quot;)\n"
"     &rArr; 25\n"
"(string-to-number &quot;X256&quot;)\n"
"     &rArr; 0\n"
"(string-to-number &quot;-4.5&quot;)\n"
"     &rArr; -4.5\n"
"(string-to-number &quot;1e5&quot;)\n"
"     &rArr; 100000.0\n"
msgstr ""

