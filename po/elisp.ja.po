# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Custom-Themes.html
msgid ""
"Two special theme names are disallowed (using them causes an error): <code "
"class=\"code\">user</code> is a dummy theme that stores the user&rsquo;s "
"direct customization settings, and <code class=\"code\">changed</code> is a "
"dummy theme that stores changes made outside of the Customize system."
msgstr ""
