#. type: Content of: <html><body><div><hr>
#: build/html/elisp/Side-Windows.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-side-windows\"></a> <a class=\"index-"
"entry-id\" id=\"index-main-window\"></a> <a class=\"index-entry-id\" "
"id=\"index-main-window-of-a-frame\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-side-windows\"></a> <a class=\"index-"
