# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><h4>
#: build/html/elisp/Character-Motion.html
msgid ""
"<span>31.2.1 Motion by Characters<a class=\"copiable-link\" href=\"#Motion-"
