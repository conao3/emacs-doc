# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Formatting-Strings.html
msgid ""
"Replace the specification with notation for a floating-point number, using "
"either exponential notation or decimal-point notation.  The exponential "
"notation is used if the exponent would be less than &minus;4 or greater than "
"or equal to the precision (default: 6).  By default, trailing zeros are "
"removed from the fractional portion of the result and a decimal-point "
"character appears only if it is followed by a digit."
msgstr ""
