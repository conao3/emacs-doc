"?\\a &rArr; 7                 ; <span class=\"r\">control-g, <kbd class=\"kbd\">C-g</kbd></span>\n"
"?\\b &rArr; 8                 ; <span class=\"r\">backspace, <kbd class=\"key\">BS</kbd>, <kbd class=\"kbd\">C-h</kbd></span>\n"
"?\\t &rArr; 9                 ; <span class=\"r\">tab, <kbd class=\"key\">TAB</kbd>, <kbd class=\"kbd\">C-i</kbd></span>\n"
"?\\n &rArr; 10                ; <span class=\"r\">newline, <kbd class=\"kbd\">C-j</kbd></span>\n"
"?\\v &rArr; 11                ; <span class=\"r\">vertical tab, <kbd class=\"kbd\">C-k</kbd></span>\n"
"?\\f &rArr; 12                ; <span class=\"r\">formfeed character, <kbd class=\"kbd\">C-l</kbd></span>\n"
"?\\r &rArr; 13                ; <span class=\"r\">carriage return, <kbd class=\"key\">RET</kbd>, <kbd class=\"kbd\">C-m</kbd></span>\n"
"?\\e &rArr; 27                ; <span class=\"r\">escape character, <kbd class=\"key\">ESC</kbd>, <kbd class=\"kbd\">C-[</kbd></span>\n"
"?\\s &rArr; 32                ; <span class=\"r\">space character, <kbd class=\"key\">SPC</kbd></span>\n"
"?\\\\ &rArr; 92                ; <span class=\"r\">backslash character, <kbd class=\"kbd\">\\</kbd></span>\n"
