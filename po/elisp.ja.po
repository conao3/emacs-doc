#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Screen-Lines.html
msgid ""
"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">move-to-window-group-line</strong> <var class=\"def-var-"
"arguments\">count</var><a class=\"copiable-link\" href=\"#index-"
"move_002dto_002dwindow_002dgroup_002dline\"> &para;</a></span>"
