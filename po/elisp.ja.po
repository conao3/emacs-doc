# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Substitution.html
msgid ""
"The translation table <var class=\"var\">table</var> is a string or a char-"
"table; <code class=\"code\">(aref <var class=\"var\">table</var> <var "
"class=\"var\">ochar</var>)</code> gives the translated character "
"corresponding to <var class=\"var\">ochar</var>.  If <var "
"class=\"var\">table</var> is a string, any characters with codes larger than "
"the length of <var class=\"var\">table</var> are not altered by the "
"translation."
msgstr ""
