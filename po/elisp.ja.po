# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dt>
#: build/html/elisp/Image-Descriptors.html
msgid ""
"<a id=\"index-edge-detection_002c-images\"></a><span><code "
