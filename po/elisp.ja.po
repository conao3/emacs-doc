"     &rArr; 97\n"
"(event-basic-type ?A)\n"
"     &rArr; 97\n"
"(event-basic-type ?\\C-a)\n"
"     &rArr; 97\n"
"(event-basic-type ?\\C-\\S-a)\n"
"     &rArr; 97\n"
"(event-basic-type 'f5)\n"
"     &rArr; f5\n"
"(event-basic-type 's-f5)\n"
"     &rArr; f5\n"
"(event-basic-type 'M-S-f5)\n"
"     &rArr; f5\n"
"(event-basic-type 'down-mouse-1)\n"
"     &rArr; mouse-1\n"
msgstr ""

