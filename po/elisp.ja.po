# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Minibuffer-Commands.html
msgid ""
"<span class=\"category-def\">Command: </span><span><strong class=\"def-"
"name\">exit-minibuffer</strong><a class=\"copiable-link\" href=\"#index-"
"exit_002dminibuffer\"> &para;</a></span>"
msgstr ""
