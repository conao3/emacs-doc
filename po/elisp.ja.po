# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Type-Keywords.html
msgid ""
"If <code class=\"code\">nil</code> is not a valid value for the alternative, "
"then it is essential to specify a valid default with <code "
"class=\"code\">:value</code>."
msgstr ""
