#: build/html/elisp/Format-Conversion-Round_002dTrip.html
#, no-wrap
msgid "(<var class=\"var\">name</var> <var class=\"var\">doc-string</var> <var class=\"var\">regexp</var> <var class=\"var\">from-fn</var> <var class=\"var\">to-fn</var> <var class=\"var\">modify</var> <var class=\"var\">mode-fn</var> <var class=\"var\">preserve</var>)\n"
