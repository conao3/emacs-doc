# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/elisp/Global-Break-Condition.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-stopping-on-events\"></a> <a "
"class=\"index-entry-id\" id=\"index-global-break-condition\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-stopping-on-events\"></a> <a "
