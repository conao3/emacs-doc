#: build/html/elisp/Bidirectional-Display.html
msgid ""
"This function returns the paragraph direction at point in the named <var "
"class=\"var\">buffer</var>.  The returned value is a symbol, either <code "
"class=\"code\">left-to-right</code> or <code class=\"code\">right-to-left</"
"code>.  If <var class=\"var\">buffer</var> is omitted or <code "
"class=\"code\">nil</code>, it defaults to the current buffer.  If the buffer-"
"local value of the variable <code class=\"code\">bidi-paragraph-direction</"
"code> is non-<code class=\"code\">nil</code>, the returned value will be "
"identical to that value; otherwise, the returned value reflects the "
"paragraph direction determined dynamically by Emacs.  For buffers whose "
"value of <code class=\"code\">bidi-display-reordering</code> is <code "
"class=\"code\">nil</code> as well as unibyte buffers, this function always "
"returns <code class=\"code\">left-to-right</code>."
msgstr ""
