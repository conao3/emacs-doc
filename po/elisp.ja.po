# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/File-Locks.html
msgid ""
"This function locks the file <var class=\"var\">filename</var>, if the "
"current buffer is modified.  The argument <var class=\"var\">filename</var> "
"defaults to the current buffer&rsquo;s visited file.  Nothing is done if the "
"current buffer is not visiting a file, or is not modified, or if the option "
"<code class=\"code\">create-lockfiles</code> is <code class=\"code\">nil</"
"code>."
msgstr ""
