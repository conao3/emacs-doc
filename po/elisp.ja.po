# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dd><p>
#: build/html/elisp/Face-Attributes.html
msgid "Draw a box with lines of width 1, in the foreground color."
msgstr "前景色で、幅1の線を用いてボックスを描いてください。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dd><p>
#: build/html/elisp/Face-Attributes.html
msgid ""
"Draw a box with lines of width 1, in color <var class=\"var\">color</var>."
msgstr "幅1の線で、色<var class=\"var\">color</var>のボックスを描画する。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dt>
#: build/html/elisp/Face-Attributes.html
