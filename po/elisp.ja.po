"name\">buffer-auto-save-file-format</strong><a class=\"copiable-link\" "
"href=\"#index-buffer_002dauto_002dsave_002dfile_002dformat\"> &para;</a></"
"span>"
msgstr ""
"<span class=\"category-def\">変数: </span><span><strong class=\"def-"
