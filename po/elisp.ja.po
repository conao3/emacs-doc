"class=\"var\">host</var>、<var class=\"var\">service</var> を上書きするため、"
"これらを指定しなくても構いません。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dt>
#: build/html/elisp/Network-Processes.html
msgid ""
"<code class=\"code\">:remote <var class=\"var\">remote-address</var></code>"
msgstr ""
"<code class=\"code\">:remote <var class=\"var\">remote-address</var></code>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dd><p>
#: build/html/elisp/Network-Processes.html
msgid ""
"For a connection, <var class=\"var\">remote-address</var> is the address to "
"connect to.  It overrides <var class=\"var\">family</var>, <var "
"class=\"var\">host</var> and <var class=\"var\">service</var>, so you might "
"as well not specify them."
msgstr ""
