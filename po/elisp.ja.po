#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Backquote-Patterns.html
msgid "<code class=\"code\">,<var class=\"var\">pattern</var></code>"
msgstr "<code class=\"code\">,<var class=\"var\">pattern</var></code>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Backquote-Patterns.html
msgid ""
"Matches if the corresponding element of <var class=\"var\">expval</var> "
"matches <var class=\"var\">pattern</var>.  Note that <var "
"class=\"var\">pattern</var> is any kind that <code class=\"code\">pcase</"
