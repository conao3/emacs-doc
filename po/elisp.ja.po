# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Jumping.html
msgid ""
"Proceed to the stop point near where point is (<code class=\"code\">edebug-"
"goto-here</code>)."
msgstr "点 (<code class=\"code\">edebug-goto-here</code>) 付近の停止点へ進む。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Jumping.html
msgid ""
"<a id=\"index-edebug_002dforward_002dsexp\"></a><span><kbd class=\"kbd\">f</"
