"href=\"#index-while_002dno_002dinput_002dignore_002devents\"> &para;</a></"
"span>"
msgstr ""
"<span class=\"category-def\">変数: </span><span><strong class=\"def-"
"name\">while-no-input-ignore-events</strong><a class=\"copiable-link\" "
"href=\"#index-while_002dno_002dinput_002dignore_002devents\"> &para;</a></"
