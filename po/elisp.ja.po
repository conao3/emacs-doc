#: build/html/elisp/Syntax-Table-Functions.html
#, no-wrap
msgid ""
";; <span class=\"r\">Put the space character in class whitespace.</span>\n"
"(modify-syntax-entry ?\\s &quot; &quot;)\n"
"     &rArr; nil\n"
msgstr ""

#. type: Content of: <html><body><div><hr><dl><dd><div><div><pre>
#: build/html/elisp/Syntax-Table-Functions.html
#, no-wrap
msgid ""
";; <span class=\"r\">Make &lsquo;<samp class=\"samp\">$</samp>&rsquo; an open parenthesis character,</span>\n"
";;   <span class=\"r\">with &lsquo;<samp class=\"samp\">^</samp>&rsquo; as its matching close.</span>\n"
"(modify-syntax-entry ?$ &quot;(^&quot;)\n"
"     &rArr; nil\n"
msgstr ""

#. type: Content of: <html><body><div><hr><dl><dd><div><div><pre>
#: build/html/elisp/Syntax-Table-Functions.html
#, no-wrap
msgid ""
";; <span class=\"r\">Make &lsquo;<samp class=\"samp\">^</samp>&rsquo; a close parenthesis character,</span>\n"
";;   <span class=\"r\">with &lsquo;<samp class=\"samp\">$</samp>&rsquo; as its matching open.</span>\n"
"(modify-syntax-entry ?^ &quot;)$&quot;)\n"
"     &rArr; nil\n"
msgstr ""

#. type: Content of: <html><body><div><hr><dl><dd><div><div><pre>
