#. type: Content of: <html><body><div><hr><h4>
#: build/html/elisp/Minor-Mode-Conventions.html
msgid ""
"<span>24.3.1 Conventions for Writing Minor Modes<a class=\"copiable-link\" "
"href=\"#Conventions-for-Writing-Minor-Modes\"> &para;</a></span>"
msgstr ""
