msgid ""
"<span class=\"category-def\">Function: </span><span><strong class=\"def-"
"name\">insert-special-event</strong> <var class=\"def-var-arguments\">event</"
"var><a class=\"copiable-link\" href=\"#index-insert_002dspecial_002devent\"> "
