#: build/html/elisp/Synchronous-Processes.html
#, no-wrap
msgid ""
"(call-process-region 1 6 &quot;cat&quot; nil t)\n"
"     &rArr; 0\n"
"\n"
"---------- Buffer: foo ----------\n"
"inputinput&lowast;\n"
"---------- Buffer: foo ----------\n"
msgstr ""

