# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Format-Conversion-Round_002dTrip.html
msgid ""
"A shell command or function to decode data in this format (to convert file "
"data into the usual Emacs data representation)."
msgstr ""
