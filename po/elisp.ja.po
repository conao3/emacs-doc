"var><a class=\"copiable-link\" href=\"#index-syntax_002dppss_002dcontext\"> "
"&para;</a></span>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Parser-State.html
