# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr>
#: build/html/elisp/Network.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-network-connection\"></a> <a "
"class=\"index-entry-id\" id=\"index-TCP\"></a> <a class=\"index-entry-id\" "
"id=\"index-UDP\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-network-connection\"></a> <a "
