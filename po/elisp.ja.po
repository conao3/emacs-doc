# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/Interactive-Examples.html
msgid "Here are some examples of <code class=\"code\">interactive</code>:"
msgstr "<code class=\"code\">interactive</code> の例をいくつか挙げます。"

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Interactive-Examples.html
#, no-wrap
msgid ""
"(defun foo1 ()              ; <span class=\"r\"><code class=\"code\">foo1</code> takes no arguments,</span>\n"
"    (interactive)           ;   <span class=\"r\">just moves forward two words.</span>\n"
"    (forward-word 2))\n"
"     &rArr; foo1\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Interactive-Examples.html
#, no-wrap
msgid ""
"(defun foo2 (n)             ; <span class=\"r\"><code class=\"code\">foo2</code> takes one argument,</span>\n"
"    (interactive &quot;^p&quot;)      ;   <span class=\"r\">which is the numeric prefix.</span>\n"
"                            ; <span class=\"r\">under <code class=\"code\">shift-select-mode</code>,</span>\n"
"                            ;   <span class=\"r\">will activate or extend region.</span>\n"
"    (forward-word (* 2 n)))\n"
"     &rArr; foo2\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Interactive-Examples.html
#, no-wrap
msgid ""
"(defun foo3 (n)             ; <span class=\"r\"><code class=\"code\">foo3</code> takes one argument,</span>\n"
"    (interactive &quot;nCount:&quot;) ;   <span class=\"r\">which is read with the Minibuffer.</span>\n"
"    (forward-word (* 2 n)))\n"
"     &rArr; foo3\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Interactive-Examples.html
#, no-wrap
msgid ""
"(defun three-b (b1 b2 b3)\n"
"  &quot;Select three existing buffers.\n"
"Put them into three windows, selecting the last one.&quot;\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><pre>
#: build/html/elisp/Interactive-Examples.html
#, no-wrap
msgid ""
"    (interactive &quot;bBuffer1:\\nbBuffer2:\\nbBuffer3:&quot;)\n"
"    (delete-other-windows)\n"
"    (split-window (selected-window) 8)\n"
"    (switch-to-buffer b1)\n"
"    (other-window 1)\n"
"    (split-window (selected-window) 8)\n"
"    (switch-to-buffer b2)\n"
"    (other-window 1)\n"
"    (switch-to-buffer b3))\n"
"     &rArr; three-b\n"
msgstr ""

#. type: Content of: <html><body><div><hr><div><div><pre>
#: build/html/elisp/Interactive-Examples.html
#, no-wrap
msgid ""
"(three-b &quot;*scratch*&quot; &quot;declarations.texi&quot; &quot;*mail*&quot;)\n"
"     &rArr; nil\n"
msgstr ""

