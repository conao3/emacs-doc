#: build/html/elisp/Regexp-Search.html
msgid ""
"<span class=\"category-def\">Command: </span><span><strong class=\"def-"
"name\">re-search-backward</strong> <var class=\"def-var-arguments\">regexp "
"&amp;optional limit noerror count</var><a class=\"copiable-link\" "
"href=\"#index-re_002dsearch_002dbackward\"> &para;</a></span>"
msgstr ""
