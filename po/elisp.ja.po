#: build/html/elisp/Documentation-Groups.html
#, no-wrap
msgid ":no-eval* (buffer-string)\n"
msgstr ""

#. type: Content of: <html><body><div><hr><dl><dd><dl><dd><div><pre>
#: build/html/elisp/Documentation-Groups.html
#, no-wrap
msgid ""
"(buffer-string)\n"
"&rarr; [it depends]\n"
msgstr ""

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dt>
#: build/html/elisp/Documentation-Groups.html
msgid "<code class=\"code\">:no-value</code>"
msgstr "<code class=\"code\">:no-value</code>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dd><p>
#: build/html/elisp/Documentation-Groups.html
msgid ""
"Like <code class=\"code\">:no-eval</code>, but is used when the function in "
