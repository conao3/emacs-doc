# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Minibuffer-Misc.html
msgid ""
"This minor mode makes editing regular expressions in the minibuffer more "
"convenient.  It highlight parens via <code class=\"code\">show-paren-mode</"
"code> and <code class=\"code\">blink-matching-paren</code> in a user-"
"friendly way, avoids reporting false paren mismatches, and makes sexp "
"navigation more intuitive."
msgstr ""
