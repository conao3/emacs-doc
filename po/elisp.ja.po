"class=\"index-entry-id\" id=\"index-control-characters_002c-reading\"></a> "
"<a class=\"index-entry-id\" id=\"index-nonprinting-characters_002c-"
"reading\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-octal-character-input\"></a> <a "
"class=\"index-entry-id\" id=\"index-control-characters_002c-reading\"></a> "
"<a class=\"index-entry-id\" id=\"index-nonprinting-characters_002c-"
