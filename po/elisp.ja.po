#. type: Content of: <html><body><div><hr><h4>
#: build/html/elisp/SMIE-Lexer.html
msgid ""
"<span>24.8.1.4 Defining Tokens<a class=\"copiable-link\" href=\"#Defining-"
"Tokens\"> &para;</a></span>"
msgstr ""
"<span>24.8.1.4 トークンの定義<a class=\"copiable-link\" href=\"#Defining-"
