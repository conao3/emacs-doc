# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dt>
#: build/html/elisp/Position-Parameters.html
msgid ""
"<a id=\"index-user_002dposition_002c-a-frame-parameter\"></a><span><code "
"class=\"code\">user-position</code><a class=\"copiable-link\" href=\"#index-"
"user_002dposition_002c-a-frame-parameter\"> &para;</a></span>"
msgstr ""
"<a id=\"index-user_002dposition_002c-a-frame-parameter\"></a><span><code "
