"<a id=\"index-invisible-_0028text-property_0029\"></a><span><code "
"class=\"code\">invisible</code><a class=\"copiable-link\" href=\"#index-"
"invisible-_0028text-property_0029\"> &para;</a></span>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Special-Properties.html
msgid ""
"A non-<code class=\"code\">nil</code> <code class=\"code\">invisible</code> "
"property can make a character invisible on the screen.  See <a "
"class=\"xref\" href=\"Invisible-Text.html\">Invisible Text</a>, for details."
msgstr ""
