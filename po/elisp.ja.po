"---------- Buffer: foo ----------\n"
"\n"
"(insert &quot;changed &quot;)\n"
"     &rArr; nil\n"
"---------- Buffer: foo ----------\n"
"This is the changed &lowast;contents of foo.\n"
"---------- Buffer: foo ----------\n"
msgstr ""

