msgstr ""

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/Association-List-Type.html
msgid ""
"sets the variable <code class=\"code\">alist-of-colors</code> to an alist of "
