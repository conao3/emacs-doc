#, no-wrap
msgid ""
"     ___________       ___________\n"
"    |           |     |     |     |\n"
"    |     A     |     |     |  B  |\n"
"    |___________| --&gt; |  A  |_____|\n"
"    |     |     |     |     |     |\n"
"    |  B  |  C  |     |     |  C  |\n"
"    |_____|_____|     |_____|_____|\n"
"\n"
msgstr ""

