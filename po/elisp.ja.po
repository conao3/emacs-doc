# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Special-Properties.html
msgid ""
"If the first character of a <code class=\"code\">help-echo</code> string has "
"a non-<code class=\"code\">nil</code> <code class=\"code\">help-echo-inhibit-"
"substitution</code> property, then it is displayed as-is by <code "
"class=\"code\">show-help-function</code>, without being passed through <code "
"class=\"code\">substitute-command-keys</code>."
msgstr ""
