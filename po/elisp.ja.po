"<a class=\"index-entry-id\" id=\"index-"
"comp_002dnative_002dversion_002ddir\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-"
"comp_002dnative_002dversion_002ddir\"></a>"

