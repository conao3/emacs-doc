"name\">window-start</strong> <var class=\"def-var-arguments\">&amp;optional "
"window</var><a class=\"copiable-link\" href=\"#index-window_002dstart\"> "
"&para;</a></span>"
msgstr ""
"<span class=\"category-def\">関数: </span><span><strong class=\"def-"
"name\">window-start</strong> <var class=\"def-var-arguments\">&amp;optional "
"window</var><a class=\"copiable-link\" href=\"#index-window_002dstart\"> "
"&para;</a></span>"

