# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><p>
#: build/html/elisp/Pattern-Matching.html
msgid ""
"There are some additional functions for queries: <code "
"class=\"code\">treesit-query-language</code> returns the language of a "
"query; <code class=\"code\">treesit-query-source</code> returns the original "
"string or sexp source query of a compiled query; <code "
"class=\"code\">treesit-query-valid-p</code> checks whether a query is valid; "
"<code class=\"code\">treesit-query-expand</code> converts a s-expression "
"query into the string format; and <code class=\"code\">treesit-pattern-"
"expand</code> converts a pattern."
msgstr ""
