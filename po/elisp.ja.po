# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><dl><dd><p>
#: build/html/elisp/Documentation-Groups.html
msgid "Indicates that this function is not documented in the manual."
msgstr "この関数がマニュアルに記載されていないことを示します。"

