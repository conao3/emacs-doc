#. type: Content of: <html><body><div><hr>
#: build/html/elisp/Window-Point.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-window-position\"></a> <a "
"class=\"index-entry-id\" id=\"index-window-point\"></a> <a class=\"index-"
"entry-id\" id=\"index-position-in-window\"></a> <a class=\"index-entry-id\" "
"id=\"index-point-in-window\"></a>"
