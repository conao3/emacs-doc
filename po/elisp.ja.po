msgid "<code class=\"code\">\\+</code>"
msgstr "<code class=\"code\">\\+</code>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Keys-in-Documentation.html
msgid ""
