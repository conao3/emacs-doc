# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd>
#: build/html/elisp/Current-Buffer.html
msgid "<a class=\"anchor\" id=\"Definition-of-with_002dtemp_002dbuffer\"></a>"
msgstr "<a class=\"anchor\" id=\"Definition-of-with_002dtemp_002dbuffer\"></a>"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Current-Buffer.html
msgid ""
"The <code class=\"code\">with-temp-buffer</code> macro evaluates the <var "
"class=\"var\">body</var> forms with a temporary buffer as the current "
"buffer.  It saves the identity of the current buffer, creates a temporary "
"buffer and makes it current, evaluates the <var class=\"var\">body</var> "
"forms, and finally restores the previous current buffer while killing the "
"temporary buffer."
msgstr ""
"<code class=\"code\">with-temp-buffer</code> マクロは、一時バッファを現在の"
"バッファとして <var class=\"var\">body</var> 形式を評価します。現在のバッファ"
"の識別情報を保存し、一時バッファを作成してそれを現在のバッファに設定し、<var "
"class=\"var\">body</var> 形式を評価し、最後に一時バッファを破棄しながら以前の"
"現在のバッファを復元します。"

# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd>
#: build/html/elisp/Current-Buffer.html
msgid ""
"<a class=\"index-entry-id\" id=\"index-undo-in-temporary-buffers\"></a> <a "
"class=\"index-entry-id\" id=\"index-kill_002dbuffer_002dhook-in-temporary-"
"buffers\"></a> <a class=\"index-entry-id\" id=\"index-"
"kill_002dbuffer_002dquery_002dfunctions-in-temporary-buffers\"></a> <a "
"class=\"index-entry-id\" id=\"index-buffer_002dlist_002dupdate_002dhook-in-"
"temporary-buffers\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-undo-in-temporary-buffers\"></a> <a "
