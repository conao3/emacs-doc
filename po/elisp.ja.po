"<a class=\"index-entry-id\" id=\"index-deferred-evaluation\"></a> <a "
"class=\"index-entry-id\" id=\"index-lazy-evaluation\"></a>"
msgstr ""
"<a class=\"index-entry-id\" id=\"index-deferred-evaluation\"></a> <a "
