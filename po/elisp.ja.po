# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Terminal-Parameters.html
msgid ""
"This function returns the value of the parameter <var "
"class=\"var\">parameter</var> (a symbol) of <var class=\"var\">terminal</"
"var>.  If <var class=\"var\">terminal</var> has no setting for <var "
"class=\"var\">parameter</var>, this function returns <code "
"class=\"code\">nil</code>."
msgstr ""
