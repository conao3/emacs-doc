# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/UUID-Generation.html
msgid ""
"This function returns a new <code class=\"code\">uuid-v5</code> Lisp object "
"based on <var class=\"var\">namespace</var>, which is a symbol in the key of "
"the <code class=\"code\">uuid-namespace-alist</code>: <code "
"class=\"code\">dns</code>, <code class=\"code\">url</code>, <code "
"class=\"code\">oid</code>, <code class=\"code\">x500</code>, or any symbol "
