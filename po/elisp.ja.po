# Machine-translated by PLaMo Translate.
#. type: Content of: <html><body><div><hr><dl><dd><p>
#: build/html/elisp/Core-Advising-Primitives.html
msgid ""
"Call the function <var class=\"var\">f</var> for every piece of advice that "
"was added to <var class=\"var\">function-def</var>.  <var class=\"var\">f</"
"var> is called with two arguments: the advice function and its properties."
msgstr ""
