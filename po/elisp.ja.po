#: build/html/elisp/Textual-Scrolling.html
msgid ""
"<span class=\"category-def\">Command: </span><span><strong class=\"def-"
"name\">recenter-top-bottom</strong> <var class=\"def-var-"
"arguments\">&amp;optional count</var><a class=\"copiable-link\" "
"href=\"#index-recenter_002dtop_002dbottom\"> &para;</a></span>"
msgstr ""
"<span class=\"category-def\">コマンド: </span><span><strong class=\"def-"
"name\">recenter-top-bottom</strong> <var class=\"def-var-"
"arguments\">&amp;optional count</var><a class=\"copiable-link\" "
